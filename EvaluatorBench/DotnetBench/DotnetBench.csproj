<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Same runtime settings as PokerBot2 -->
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <NoWarn>$(NoWarn);CS8632;CA2014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PokerBot2\PokerBot2.csproj" />
    <!-- poker.net's evaluator, compiled from the clone in ..\external\poker.net (see ..\README.md) -->
    <Compile Include="..\external\poker.net\Services\PokerLib.cs" Link="External\PokerLib.cs" />
  </ItemGroup>

</Project>
